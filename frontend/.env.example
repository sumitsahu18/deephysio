# =====================================================================
#  DeePhysio FRONTEND - settings (koi password nahi). Production build ke liye.
#  Local development ke liye .env.development pehle se hai - kuch copy nahi karna.
# =====================================================================

# false = asli backend (Express + MongoDB). true = sirf demo (browser localStorage, koi server nahi)
VITE_USE_MOCK=false

# Backend ka address. Same domain / Netlify proxy par /api hi rehne do.
VITE_API_URL=/api
