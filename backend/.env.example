# =====================================================================
#  DeePhysio BACKEND - environment settings. Copy to backend/.env and fill in.
#  .env kabhi Git / zip / email mein share mat karna (passwords hain).
# =====================================================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000

# MongoDB Atlas (client ke account mein, UK/EU region) ya VPS par MongoDB.
# Dedicated DB user banao jiske paas SIRF is database ka readWrite ho (PDF 2.1).
MONGODB_URI=mongodb://127.0.0.1:27017/deephysio

# JWT secrets - do ALAG lambi random values (min 32 characters). Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-generate-a-long-random-value-1
JWT_REFRESH_SECRET=change-me-generate-a-different-long-random-value-2
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Website address(es). Production: https://deephysio.co.uk,https://www.deephysio.co.uk
CLIENT_ORIGINS=http://localhost:5173
# Production (HTTPS) mein dono true
COOKIE_SECURE=false
TRUST_PROXY=false
# Production: true -> Express hi built website bhi chalata hai (pehle frontend mein npm run build)
SERVE_CLIENT=false
CLIENT_DIST=../frontend/dist

# Uploads (images) - folder project ke bahar bhi rakh sakte ho, e.g. /var/www/deephysio-uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ---------- Enquiry email (authenticated SMTP - PDF 2.4) ----------
# Brevo / SendGrid / Fasthosts mailbox. Khali chhodo to enquiries sirf admin mein dikhengi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DeePhysio Website <no-reply@deephysio.co.uk>"
CLINIC_NOTIFICATION_EMAIL=deephysioclinic@gmail.com

# UK GDPR: itne din baad purani enquiries apne aap delete (client se confirm karo). 0 = kabhi nahi
ENQUIRY_RETENTION_DAYS=365

# ---------- Pehla Admin (sirf npm run seed ke liye; uske baad ADMIN_PASSWORD hata do) ----------
ADMIN_NAME=Clinic Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
